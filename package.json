{
  "name": "wellfound-application-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, safety-gated Wellfound application orchestrator",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  },
  "bin": {
    "wellfound-orchestrator": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "cli": "node dist/cli/main.js",
    "setup": "npm run build && npm run cli -- setup",
    "start": "npm run build && npm run cli --"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "eslint": "10.9.1",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
